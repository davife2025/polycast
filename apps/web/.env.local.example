# Copy this file to .env.local in this same directory (apps/web/.env.local)
# — Next.js only reads env files from the app's own folder, not the
# monorepo root. The root .env.example is a consolidated reference across
# all three apps/packages; this is the one that actually gets loaded here.

# --- Supabase (get from your Supabase project's Settings > API page) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Flare Coston2 (these defaults are correct as-is, no account needed) ---
NEXT_PUBLIC_CHAIN_ID=114
NEXT_PUBLIC_RPC_URL=https://coston2-api.flare.network/ext/C/rpc
NEXT_PUBLIC_EXPLORER_URL=https://coston2-explorer.flare.network

# --- Contract addresses (printed by `npm run deploy:coston2` in packages/contracts) ---
NEXT_PUBLIC_MARKET_FACTORY_ADDRESS=
NEXT_PUBLIC_AMM_FACTORY_ADDRESS=
