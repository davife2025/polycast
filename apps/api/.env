# Copy this file to .env in this same directory (apps/api/.env) —
# dotenv loads from the current working directory, which is apps/api
# when this service runs. The root .env.example is a consolidated
# reference across all three apps/packages; this is the one that
# actually gets loaded here.

# --- Supabase (get from your Supabase project's Settings > API page) ---
# SERVICE ROLE key, not anon — this bypasses Row Level Security, so it
# must never end up in apps/web or any browser-shipped code.
SUPABASE_URL=https://mfjcfvejmxqwqgvqbegm.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Im1mamNmdmVqbXhxd3FndnFiZWdtIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImlhdCI6MTc4NTY4OTg1NiwiZXhwIjoyMTAxMjY1ODU2fQ.mzPGta7CaFnCqIqBbvcbqVNRnNearRIlmigLEPjaEvs

# --- Flare Coston2 ß(this default is correct as-is, no account needed) ---
RPC_URL=https://coston2-api.flare.network/ext/C/rpc
CHAIN_ID=114

# --- Contract addresses (printed by `npm run deploy:coston2` in packages/contracts) ---
MARKET_FACTORY_ADDRESS=
AMM_FACTORY_ADDRESS=

PORT=4000

# Stopgap until resolver contracts expose their own type — see
# apps/api/src/indexer/resolverType.ts for why this exists. Populate
# after deploying, using the resolver addresses that script prints.
# Example: {"0xabc...":"manual"}
RESOLVER_TYPE_MAP={}
