# Copy this file to .env in this same directory (apps/api/.env) —
# dotenv loads from the current working directory, which is apps/api
# when this service runs. The root .env.example is a consolidated
# reference across all three apps/packages; this is the one that
# actually gets loaded here.

# --- Supabase (get from your Supabase project's Settings > API page) ---
# SERVICE ROLE key, not anon — this bypasses Row Level Security, so it
# must never end up in apps/web or any browser-shipped code.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Flare Coston2 (this default is correct as-is, no account needed) ---
RPC_URL=https://coston2-api.flare.network/ext/C/rpc
CHAIN_ID=114

# --- Contract addresses (printed by `npm run deploy:coston2` in packages/contracts) ---
MARKET_FACTORY_ADDRESS=
AMM_FACTORY_ADDRESS=
ORACLE_MINTER_FACTORY_ADDRESS=

PORT=4000

# Stopgap until resolver contracts expose their own type — see
# apps/api/src/indexer/resolverType.ts for why this exists. Populate
# after deploying, using the resolver addresses that script prints.
# Example: {"0xabc...":"manual"}
RESOLVER_TYPE_MAP={}

# --- Polymarket price relayer (optional - only needed for tracking markets) ---
# Address of a deployed PolymarketPriceOracle contract.
PRICE_ORACLE_ADDRESS=
# Private key of the wallet set as that oracle's `relayer`. Testnet-only
# key, never reused, same rules as packages/contracts/.env's PRIVATE_KEY.
RELAYER_PRIVATE_KEY=
# How often to poll Polymarket for each tracked market, in milliseconds.
RELAYER_POLL_INTERVAL_MS=15000
# JSON array mapping each tracked market to a Polymarket CLOB token_id.
# oracleMarketId must match what was used when creating the
# PolycastOracleMinter for that market (see packages/contracts).
# Example:
# TRACKING_MARKETS=[{"oracleMarketId":"0x...","polymarketTokenId":"123...","label":"Will X happen?"}]
TRACKING_MARKETS=[]
